{
  "version": "1.0.0",
  "description": "机关事业单位工资测算",
  "author": "且听风吟",
  "name": "sandbox-workspace",
  "main": "electron/main.cjs",
  "private": true,
  "type": "module",
"build": {
  "productName": "sandbox-workspace",
  "appId": "com.yourcompany.sandbox-workspace",
  "directories": {
    "output": "release"
  },
  "afterPack": "scripts/afterPack.cjs", 
  "files": [
    "dist/**/*",
    "electron/**/*"
  ],
  "asar": true,
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      }
    ],
    "compression": "maximum"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "include": "build/installer.nsh",
    "deleteAppDataOnUninstall": false
  }
},
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "electron": "electron .",
    "electron:build": "vite build && npx electron-builder --win",
    "verify-roundtrip": "npx -y tsx scripts/verify-roundtrip.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.1.0",
    "@dnd-kit/sortable": "^8.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@supabase/supabase-js": "^2.98.0",
    "canvas-confetti": "^1.9.3",
    "date-fns": "^2.30.0",
    "framer-motion": "^11.16.1",
    "jszip": "^3.10.1",
    "lucide-react": "^0.294.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.8.0",
    "recharts": "^2.10.0",
    "sql.js": "^1.14.2",
    "uuid": "^9.0.1",
    "vite-plugin-singlefile": "^2.3.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.7",
    "@types/canvas-confetti": "^1.6.4",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@types/uuid": "^9.0.7",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "tailwindcss": "^4.1.7",
    "typescript": "^5.7.0",
    "vite": "^6.3.5"
  }
}
